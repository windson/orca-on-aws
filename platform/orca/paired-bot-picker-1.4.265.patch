@@ -0,0 +1,42 @@
+// @vitest-environment happy-dom
+import { cleanup, renderHook } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+import type { ExecutionHostId } from '../../../../shared/execution-host/execution-host'
+import { useNewTabAgentMenuRows } from '../agent/launch-menu/use-new-tab-agent-menu-rows'
+import { useBotAgentMenu } from './use-bot-agent-choices'
+
+vi.mock('@/lib/bot-hosts', () => ({
+  botHostTarget: (id: ExecutionHostId) =>
+    id === 'local'
+      ? { kind: 'local' }
+      : { kind: 'environment', environmentId: id.slice('runtime:'.length) }
+}))
+vi.mock('../agent/launch-menu/use-new-tab-agent-menu-rows', () => ({
+  useNewTabAgentMenuRows: vi.fn(() => ({ state: 'loading', placeholderCount: 2 }))
+}))
+
+afterEach(() => {
+  cleanup()
+  vi.clearAllMocks()
+})
+
+it('checks chat support and detects installed agents on the same computer after switching hosts', () => {
+  const local: ExecutionHostId = 'local'
+  const paired: ExecutionHostId = 'runtime:paired'
+  const initialProps: { host: ExecutionHostId } = { host: local }
+  const menu = renderHook(({ host }) => useBotAgentMenu(host, true), {
+    initialProps
+  })
+  menu.rerender({ host: paired })
+  expect(useNewTabAgentMenuRows).toHaveBeenLastCalledWith(
+    { workspace: { kind: 'folder', executionHostId: paired } },
+    true,
+    { kind: 'runtime', environmentId: 'paired' }
+  )
+  menu.rerender({ host: local })
+  expect(useNewTabAgentMenuRows).toHaveBeenLastCalledWith(
+    { workspace: { kind: 'folder', executionHostId: local } },
+    true,
+    { kind: 'local' }
+  )
+})
