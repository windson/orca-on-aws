{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private-access Orca development workstation on Amazon Linux 2023.",
  "Parameters": {
    "WorkspaceSnapshotId": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^snap-[a-f0-9]+$",
      "Description": "Optional same-region snapshot to restore an existing workspace"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "g5.2xlarge",
      "Description": "GPU development workstation. Choose t3.large for a lower-cost CPU host.",
      "AllowedValues": [
        "t3.medium",
        "t3.large",
        "g5.2xlarge"
      ]
    },
    "RootVolumeSizeGiB": {
      "Type": "Number",
      "Default": 30,
      "MinValue": 16,
      "MaxValue": 16384,
      "Description": "Encrypted root disk size for a NEW host; existing root expansion requires separate review"
    },
    "WorkspaceVolumeSizeGiB": {
      "Type": "Number",
      "Default": 150,
      "MinValue": 30,
      "MaxValue": 65536,
      "Description": "Durable encrypted workspace size; existing disks must never shrink"
    },
    "AvailabilityZone": {
      "Type": "AWS::EC2::AvailabilityZone::Name",
      "Description": "Availability Zone offering the selected x86_64 instance type."
    },
    "ImageId": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Amazon Linux 2023 x86_64 AMI with SSM Agent for Nitro instances"
    }
  },
  "Conditions": {
    "RestoreWorkspace": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "WorkspaceSnapshotId"
            },
            ""
          ]
        }
      ]
    },
    "BurstableInstance": {
      "Fn::Or": [
        {
          "Fn::Equals": [
            {
              "Ref": "InstanceType"
            },
            "t3.medium"
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "InstanceType"
            },
            "t3.large"
          ]
        }
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.42.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-vpc"
            }
          }
        ]
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.1.0/24",
        "AvailabilityZone": {
          "Ref": "AvailabilityZone"
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-public"
            }
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway"
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "PublicRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "SubnetRouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      }
    },
    "HostRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          },
          {
            "Ref": "ParameterStoreBoundary"
          }
        ]
      }
    },
    "HostProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "HostRole"
          }
        ]
      }
    },
    "HostSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Orca workstation with outbound HTTPS and no inbound rules",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "HTTPS for AWS APIs, package downloads and tailnet relays"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-ssm-only"
            }
          }
        ]
      }
    },
    "WorkspaceVolume": {
      "Type": "AWS::EC2::Volume",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "AvailabilityZone": {
          "Ref": "AvailabilityZone"
        },
        "Size": {
          "Ref": "WorkspaceVolumeSizeGiB"
        },
        "VolumeType": "gp3",
        "Encrypted": true,
        "KmsKeyId": "alias/aws/ebs",
        "SnapshotId": {
          "Fn::If": [
            "RestoreWorkspace",
            {
              "Ref": "WorkspaceSnapshotId"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-workspace"
            }
          }
        ]
      }
    },
    "Host": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "PublicRoute",
        "SubnetRouteAssociation"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "ImageId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "IamInstanceProfile": {
          "Ref": "HostProfile"
        },
        "NetworkInterfaces": [
          {
            "AssociatePublicIpAddress": true,
            "DeviceIndex": "0",
            "SubnetId": {
              "Ref": "Subnet"
            },
            "GroupSet": [
              {
                "Ref": "HostSecurityGroup"
              }
            ]
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": {
                "Ref": "RootVolumeSizeGiB"
              },
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "EbsOptimized": true,
        "CreditSpecification": {
          "Fn::If": [
            "BurstableInstance",
            {
              "CPUCredits": "standard"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-host"
            }
          }
        ],
        "Monitoring": true
      }
    },
    "WorkspaceAttachment": {
      "Type": "AWS::EC2::VolumeAttachment",
      "Properties": {
        "Device": "/dev/sdf",
        "InstanceId": {
          "Ref": "Host"
        },
        "VolumeId": {
          "Ref": "WorkspaceVolume"
        }
      }
    },
    "ParameterStoreBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Action": [
                "ssm:GetParameter",
                "ssm:GetParameters",
                "ssm:GetParametersByPath",
                "ssm:GetParameterHistory"
              ],
              "Resource": "*"
            }
          ]
        }
      }
    },
    "BackupVault": {
      "Type": "AWS::Backup::BackupVault",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BackupVaultName": {
          "Fn::Join": [
            "-",
            [
              "orca",
              {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Ref": "AWS::StackId"
                      }
                    ]
                  }
                ]
              }
            ]
          ]
        }
      }
    },
    "BackupRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "backup.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:backup:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSBackupServiceRolePolicyForBackup"
          }
        ]
      }
    },
    "BackupPlan": {
      "Type": "AWS::Backup::BackupPlan",
      "Properties": {
        "BackupPlan": {
          "BackupPlanName": "orca-daily-workspace",
          "BackupPlanRule": [
            {
              "RuleName": "DailyWorkspace",
              "TargetBackupVault": {
                "Ref": "BackupVault"
              },
              "ScheduleExpression": "cron(0 5 * * ? *)",
              "StartWindowMinutes": 60,
              "CompletionWindowMinutes": 240,
              "Lifecycle": {
                "DeleteAfterDays": 14
              }
            }
          ]
        }
      }
    },
    "BackupSelection": {
      "Type": "AWS::Backup::BackupSelection",
      "Properties": {
        "BackupPlanId": {
          "Ref": "BackupPlan"
        },
        "BackupSelection": {
          "SelectionName": "workspace",
          "IamRoleArn": {
            "Fn::GetAtt": [
              "BackupRole",
              "Arn"
            ]
          },
          "Resources": [
            {
              "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:volume/${WorkspaceVolume}"
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Host"
      }
    },
    "WorkspaceVolumeId": {
      "Value": {
        "Ref": "WorkspaceVolume"
      }
    },
    "WorkspaceBackupVault": {
      "Value": {
        "Ref": "BackupVault"
      }
    }
  }
}
